pgpmode=none,\
compression=xz,\
repack,repacksuffix=+ds,\
dversionmangle=s{[+~](dfsg|ds)\d*}{},\
uversionmangle=s{[\-]}{.}g,\
filenamemangle=s%v?@ANY_VERSION@%@PACKAGE@-$1.tar.xz%,\
searchmode=plain,\
" https://api.github.com/repos/wasix-org/wasix-libc/releases?per_page=99 \
  https://api.github.com/repos/[^/]+/[^/]+/tarball/v?([\d.\-]+) debian uupdate
