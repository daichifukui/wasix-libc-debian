#!/usr/bin/make -f

# Pass the toolchain on the make command line so that it takes precedence
# over CC/AR/NM coming from the environment or MAKEFLAGS (e.g. CC=gcc).
TOOLCHAIN = CC=clang AR=llvm-ar NM=llvm-nm

export TARGET_OS = wasix
export TARGET_ARCH = wasm32

%:
	dh $@ --without single-binary

override_dh_auto_build:
	dh_auto_build -- $(TOOLCHAIN) finish

override_dh_installexamples:
	dh_installexamples -Xgitignore


# Copy the sysroot built by dh_auto_build, as upstream's "install" target
# does. Running "make install" would compile everything again, since all
# objects depend on the phony "include_dirs" target.
override_dh_auto_install:
	mkdir -p $(CURDIR)/debian/tmp/usr
	cp -r $(CURDIR)/sysroot/lib $(CURDIR)/sysroot/share $(CURDIR)/sysroot/include $(CURDIR)/debian/tmp/usr
	find $(CURDIR)/debian/tmp/usr -type d -empty -delete
